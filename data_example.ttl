@prefix ex: <http://example.com/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:ExampleMainProcessor
    a dpv:DataProcessor , dpv:SMEOrganisation;
    dpv:hasName "Processing Company" ; # A30-1-29
    dpv:hasContact "info2@company.com" ; # A30-1-30
    dpv:hasRecordsOfActivities ex:ProcessorROPA .

ex:ProcessorROPA
    a dpv:ROPA ; # or DataProcessingRecord # A30-1-27
    dpv:hasLegalBasis dpv:SubProcessorAgreement;
    dpv:hasDataProcessor ex:ExampleMainProcessor ; # G_Base-1
    dpv:hasDataProcessor ex:ExampleSubProcessor ; # A30-1-36
    dpv:hasRepresentative ex:EURepresentative ; # A30-1-31
    dpv:hasDataProtectionOfficer ex:DPO1 ; # A30-1-34
    dpv:hasTechnicalMeasure ex:EncryptionMeasure ;
    dpv:hasOrganisationalMeasure ex:AccessControlPolicy;
    dpv:hasProcess ex:ProcessingActivityForProcessor .     