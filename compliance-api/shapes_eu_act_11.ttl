@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix tech: <https://w3id.org/dpv/tech#> .
@prefix eu-aiact: <https://w3id.org/dpv/legal/eu/aiact#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix recitals: <http://example.org/recitals/> .

#################################################
# EU AI Act Article 11 - Technical documentation
# (contents per Annex IV)
#
# Applies to high-risk AI systems (eu-aiact:HighRiskAISystem).
# Terms come from DPV 2.3 and its tech: and eu-aiact:
# extensions, plus Dublin Core and schema.org. The DPV
# ontology is not loaded, so a system typed with a narrower
# concept also needs the eu-aiact:HighRiskAISystem type.
#
#   ?system tech:hasDocumentation ?doc
#   ?doc    a eu-aiact:TechnicalDocumentation
#   ?system tech:hasProvider ?provider
#   ?system dpv:hasPurpose or tech:hasIntendedUse ?purpose
#   ?system schema:version "x.y"
#   ?system tech:hasMarketAvailabilityStatus or tech:hasProvisionStatus ?status
#   ?status a eu-aiact:PlacedOnMarket, PlacedOnEUMarket,
#             PutIntoService or PutIntoServiceInEU ;
#           dct:date "yyyy-mm-dd"
#   ?doc    dct:created, dct:modified (xsd:date or xsd:dateTime)
#   ?doc    schema:version "x.y"   (the system version it covers)
#
# Annex IV sections: ?doc dct:hasPart ?section, where the
# section is (an instance of) the DPV concept:
#   1 eu-aiact:InstructionForUse
#   2 eu-aiact:SystemArchitectureDescription
#   3 eu-aiact:ProviderHumanOversightMeasure
#   4 eu-aiact:AISystemPerformance
#   5 eu-aiact:RiskManagementSystem        (Art. 9)
#   6 eu-aiact:ChangeDescription
#   7 dct:conformsTo a standard, or a part that is an
#     eu-aiact:CommonSpecification
#   8 eu-aiact:EUDeclarationOfConformity   (Art. 47)
#   9 eu-aiact:PostMarketMonitoringPlan or
#     eu-aiact:PostMarketMonitoringSystemDocumentation (Art. 72)
#################################################

ex:
    sh:declare [
        sh:prefix "dpv" ;
        sh:namespace "https://w3id.org/dpv#"^^xsd:anyURI ;
    ] , [
        sh:prefix "tech" ;
        sh:namespace "https://w3id.org/dpv/tech#"^^xsd:anyURI ;
    ] , [
        sh:prefix "eu-aiact" ;
        sh:namespace "https://w3id.org/dpv/legal/eu/aiact#"^^xsd:anyURI ;
    ] , [
        sh:prefix "schema" ;
        sh:namespace "https://schema.org/"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
    ] , [
        sh:prefix "dct" ;
        sh:namespace "http://purl.org/dc/terms/"^^xsd:anyURI ;
    ] .

#################################################
# Scope: there must be a high-risk AI system
#################################################

ex:AIActArt11ScopeShape
    a sh:NodeShape ;
    sh:targetNode recitals:AIActArticle11Scope ;

    # EU AI Act Art. 11 scope: fails when the data has nothing this article applies to
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-0"^^xsd:string ;
        sh:message "No high-risk AI system (eu-aiact:HighRiskAISystem) found; Art. 11 cannot be assessed." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { ?s rdf:type eu-aiact:HighRiskAISystem . }
            }
        """ ;
    ] .

#################################################
# High-risk AI system
#################################################

ex:AIActArt11SystemShape
    a sh:NodeShape ;
    sh:targetClass eu-aiact:HighRiskAISystem ;

    # Art. 11(1): technical documentation exists
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-1-1"^^xsd:string ;
        sh:message "High-risk AI system has no technical documentation (tech:hasDocumentation, a eu-aiact:TechnicalDocumentation) (Art. 11(1))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this tech:hasDocumentation ?doc .
                    ?doc rdf:type eu-aiact:TechnicalDocumentation .
                }
            }
        """ ;
    ] ;

    # Annex IV 1(a): provider and intended purpose
    sh:property [
        sh:path tech:hasProvider ;
        dct:identifier "AIA11-AIV-1"^^xsd:string ;
        sh:minCount 1 ;
        sh:message "Provider of the AI system (tech:hasProvider) is not identified (Annex IV 1(a))." ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 1: intended purpose
    sh:property [
        sh:path [ sh:alternativePath ( dpv:hasPurpose tech:hasIntendedUse ) ] ;
        dct:identifier "AIA11-AIV-1"^^xsd:string ;
        sh:minCount 1 ;
        sh:message "Intended purpose of the AI system (tech:hasIntendedUse or dpv:hasPurpose) is not stated (Annex IV 1(a))." ;
    ] ;

    # Annex IV 1(a)-(b): versions
    sh:property [
        sh:path schema:version ;
        dct:identifier "AIA11-AIV-1"^^xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Version of the AI system (schema:version) is not stated (Annex IV 1(a))." ;
    ] ;

    # Art. 11(1): drawn up before placing on the market / putting into service
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-1-2"^^xsd:string ;
        sh:message "Technical documentation was drawn up after the AI system was placed on the market or put into service (Art. 11(1))." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this tech:hasDocumentation ?value .
                ?value rdf:type eu-aiact:TechnicalDocumentation ;
                       dct:created ?created .
                $this tech:hasMarketAvailabilityStatus|tech:hasProvisionStatus ?status .
                ?status rdf:type ?c ;
                        dct:date ?onMarket .
                FILTER (?c IN (eu-aiact:PlacedOnMarket, eu-aiact:PlacedOnEUMarket,
                               eu-aiact:PutIntoService, eu-aiact:PutIntoServiceInEU))
                # Compare the ISO date part so xsd:date and xsd:dateTime mix
                FILTER (SUBSTR(STR(?created), 1, 10) > SUBSTR(STR(?onMarket), 1, 10))
            }
        """ ;
    ] ;

    # Art. 11(1): kept up to date
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-1-3"^^xsd:string ;
        sh:message "Technical documentation does not cover the current version of the AI system (schema:version); it must be kept up to date (Art. 11(1))." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this schema:version ?version ;
                      tech:hasDocumentation ?value .
                ?value rdf:type eu-aiact:TechnicalDocumentation .
                FILTER NOT EXISTS { ?value schema:version ?version . }
            }
        """ ;
    ] .

#################################################
# Technical documentation (Annex IV)
#################################################

ex:AIActArt11DocumentationShape
    a sh:NodeShape ;
    sh:targetClass eu-aiact:TechnicalDocumentation ;

    # EU AI Act Art. 11(1): technical documentation has no creation date, so it cannot be shown to predate placing on the market
    sh:property [
        sh:path dct:created ;
        dct:identifier "AIA11-1-2"^^xsd:string ;
        sh:minCount 1 ;
        sh:message "Technical documentation has no creation date (dct:created), so it cannot be shown to predate placing on the market (Art. 11(1))." ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 1
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-1"^^xsd:string ;
        sh:message "Technical documentation lacks a general description of the AI system, including the instructions for use (eu-aiact:InstructionForUse) (Annex IV 1)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (eu-aiact:InstructionForUse))
                }
            }
        """ ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 2
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-2"^^xsd:string ;
        sh:message "Technical documentation lacks a detailed description of the system's elements and development process, including its architecture (eu-aiact:SystemArchitectureDescription) (Annex IV 2)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (eu-aiact:SystemArchitectureDescription))
                }
            }
        """ ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 3
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-3"^^xsd:string ;
        sh:message "Technical documentation lacks information on monitoring, functioning and control, including human oversight measures (eu-aiact:ProviderHumanOversightMeasure) (Annex IV 3)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (eu-aiact:ProviderHumanOversightMeasure))
                }
            }
        """ ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 4
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-4"^^xsd:string ;
        sh:message "Technical documentation lacks a description of the appropriateness of the performance metrics (eu-aiact:AISystemPerformance) (Annex IV 4)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (eu-aiact:AISystemPerformance))
                }
            }
        """ ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 5
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-5"^^xsd:string ;
        sh:message "Technical documentation lacks a description of the risk management system under Art. 9 (eu-aiact:RiskManagementSystem) (Annex IV 5)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (eu-aiact:RiskManagementSystem))
                }
            }
        """ ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 8
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-8"^^xsd:string ;
        sh:message "Technical documentation lacks a copy of the EU declaration of conformity (eu-aiact:EUDeclarationOfConformity) (Annex IV 8)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (eu-aiact:EUDeclarationOfConformity))
                }
            }
        """ ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 9
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-9"^^xsd:string ;
        sh:message "Technical documentation lacks a description of the post-market monitoring system and plan (eu-aiact:PostMarketMonitoringPlan) (Annex IV 9)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (eu-aiact:PostMarketMonitoringPlan, eu-aiact:PostMarketMonitoringSystemDocumentation))
                }
            }
        """ ;
    ] ;

    # EU AI Act Art. 11, Annex IV point 7: standards applied or other solutions adopted
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-7"^^xsd:string ;
        sh:message "Technical documentation lists neither the harmonised standards applied (dct:conformsTo) nor the other solutions adopted to meet the requirements (eu-aiact:CommonSpecification) (Annex IV 7)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this dct:conformsTo ?standard . }
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* eu-aiact:CommonSpecification .
                }
            }
        """ ;
    ] .

# Same target, warning level
ex:AIActArt11DocumentationWarningShape
    a sh:NodeShape ;
    sh:targetClass eu-aiact:TechnicalDocumentation ;
    sh:severity sh:Warning ;

    # EU AI Act Art. 11, Annex IV point 6: changes through the lifecycle
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "AIA11-AIV-6"^^xsd:string ;
        sh:message "Technical documentation lacks a description of relevant changes made through the system's lifecycle (eu-aiact:ChangeDescription) (Annex IV 6)." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dct:hasPart ?part .
                    ?part rdf:type?/rdfs:subClassOf* eu-aiact:ChangeDescription .
                }
            }
        """ ;
    ] .
