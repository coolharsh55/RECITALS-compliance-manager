@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix recitals: <http://example.org/recitals/> .

#################################################
# GDPR Article 32 - Security of processing
#
# Checked per processing activity (dpv:Process).
#
# A measure counts as a given kind when it is that DPV
# concept itself (dpv:hasTechnicalMeasure dpv:Encryption),
# an instance of it (ex:M a dpv:Encryption), or of a
# subclass declared in the data.
#
# Art. 32(1)(a)-(d) list measures "as appropriate", so a
# missing one is a Warning; it becomes a Violation where
# the processing involves special category data or a high
# risk level, which raises what is appropriate.
#################################################

ex:
    sh:declare [
        sh:prefix "dpv" ;
        sh:namespace "https://w3id.org/dpv#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
    ] .

#################################################
# Scope: there must be something to assess
#################################################

ex:Art32ScopeShape
    a sh:NodeShape ;
    sh:targetNode recitals:GDPRArticle32Scope ;

    # GDPR Art. 32 scope: fails when the data has nothing this article applies to
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "A32-0"^^xsd:string ;
        sh:message "No processing activity (dpv:Process) found; Art. 32 cannot be assessed." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { ?p rdf:type dpv:Process . }
            }
        """ ;
    ] .

#################################################
# Processing activity
#################################################

ex:Art32ProcessingShape
    a sh:NodeShape ;
    sh:targetClass dpv:Process ;

    # Art. 32(1): appropriate technical and organisational measures
    sh:property [
        sh:path dpv:hasTechnicalMeasure ;
        dct:identifier "A32-1-1"^^xsd:string ;
        sh:minCount 1 ;
        sh:message "No technical security measures implemented for the processing activity (Art. 32(1))." ;
    ] ;

    # GDPR Art. 32(1): no organisational security measures implemented for the processing activity
    sh:property [
        sh:path dpv:hasOrganisationalMeasure ;
        dct:identifier "A32-1-2"^^xsd:string ;
        sh:minCount 1 ;
        sh:message "No organisational security measures implemented for the processing activity (Art. 32(1))." ;
    ] ;

    # Art. 32(1) and (2): level of security must take account of the risk
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "A32-2"^^xsd:string ;
        sh:message "Risk to data subjects not assessed: no risk, risk level or risk assessment recorded (Art. 32(1)-(2))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS { $this dpv:hasRisk ?r . }
                FILTER NOT EXISTS { $this dpv:hasRiskLevel ?l . }
                FILTER NOT EXISTS {
                    $this dpv:hasOrganisationalMeasure ?m .
                    ?m rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:RiskAssessment, dpv:DPIA))
                }
            }
        """ ;
    ] ;

    # Art. 32(1)(a): pseudonymisation and encryption (sensitive processing)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "A32-1-a"^^xsd:string ;
        sh:message "Processing involves special category data or high risk but neither encryption nor pseudonymisation is applied (Art. 32(1)(a))." ;
        sh:select """
            SELECT $this WHERE {
                {
                    $this dpv:hasPersonalData ?pd .
                    ?pd rdf:type?/rdfs:subClassOf* dpv:SpecialCategoryPersonalData .
                } UNION {
                    $this dpv:hasRiskLevel ?level .
                    ?level rdf:type?/rdfs:subClassOf* ?high .
                    FILTER (STRENDS(STR(?high), "HighRisk") || STRENDS(STR(?high), "VeryHighRisk"))
                }
                FILTER NOT EXISTS {
                    $this dpv:hasTechnicalMeasure ?m .
                    ?m rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:Encryption, dpv:Pseudonymisation))
                }
            }
        """ ;
    ] .

# Same targets, warning level: checks the law asks for "as appropriate" or "where appropriate"
ex:Art32ProcessingWarningShape
    a sh:NodeShape ;
    sh:targetClass dpv:Process ;
    # Severity applies to every constraint of a shape, so the
    # "as appropriate" checks live in their own shape.
    sh:severity sh:Warning ;

    # Art. 32(1)(a): pseudonymisation and encryption (as appropriate)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "A32-1-a"^^xsd:string ;
        sh:message "Neither encryption nor pseudonymisation of personal data is recorded (Art. 32(1)(a))." ;
        sh:select """
            SELECT $this WHERE {
                # Sensitive processing is reported as a Violation above
                FILTER NOT EXISTS {
                    $this dpv:hasPersonalData ?pd .
                    ?pd rdf:type?/rdfs:subClassOf* dpv:SpecialCategoryPersonalData .
                }
                FILTER NOT EXISTS {
                    $this dpv:hasRiskLevel ?level .
                    ?level rdf:type?/rdfs:subClassOf* ?high .
                    FILTER (STRENDS(STR(?high), "HighRisk") || STRENDS(STR(?high), "VeryHighRisk"))
                }
                FILTER NOT EXISTS {
                    $this dpv:hasTechnicalMeasure ?m .
                    ?m rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:Encryption, dpv:Pseudonymisation))
                }
            }
        """ ;
    ] ;

    # Art. 32(1)(b): confidentiality, integrity, availability and resilience
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "A32-1-b"^^xsd:string ;
        sh:message "No measure ensuring ongoing confidentiality and integrity (e.g. access control, authentication) is recorded (Art. 32(1)(b))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dpv:hasTechnicalMeasure|dpv:hasOrganisationalMeasure ?m .
                    ?m rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:AccessControlMethod, dpv:AuthenticationProtocols, dpv:Encryption, dpv:SecurityMethod))
                }
            }
        """ ;
    ] ;

    # Art. 32(1)(c): restore availability and access after an incident
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "A32-1-c"^^xsd:string ;
        sh:message "No backup or recovery measure to restore availability of personal data after an incident is recorded (Art. 32(1)(c))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dpv:hasTechnicalMeasure|dpv:hasOrganisationalMeasure ?m .
                    ?m rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:DataBackupProtocols, dpv:DisasterRecoveryProcedures, dpv:IncidentManagementProcedures))
                }
            }
        """ ;
    ] ;

    # Art. 32(1)(d): regular testing and evaluation of effectiveness
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "A32-1-d"^^xsd:string ;
        sh:message "No process for regularly testing and evaluating the security measures is recorded (Art. 32(1)(d))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dpv:hasOrganisationalMeasure ?m .
                    ?m rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:ReviewProcedure, dpv:CybersecurityAssessment, dpv:Certification))
                }
            }
        """ ;
    ] ;

    # Art. 32(4): persons acting under authority process only on instruction
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "A32-4"^^xsd:string ;
        sh:message "No staff training or confidentiality obligation for persons with access to personal data is recorded (Art. 32(4))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dpv:hasOrganisationalMeasure ?m .
                    ?m rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:StaffTraining, dpv:DataProtectionTraining, dpv:CybersecurityTraining, dpv:NDA))
                }
            }
        """ ;
    ] .
