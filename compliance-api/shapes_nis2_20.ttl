@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix risk: <https://w3id.org/dpv/risk#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix recitals: <http://example.org/recitals/> .

#################################################
# NIS2 Article 20 - Governance
#
# Applies to essential and important entities, typed
# recitals:EssentialEntity or recitals:ImportantEntity.
#
# Vocabulary not covered by DPV (recitals: namespace):
#   ?entity   recitals:hasManagementBody ?body
#   ?body     a recitals:ManagementBody
#   ?measure  recitals:approvedBy ?body
#   ?measure  recitals:implementationOverseenBy ?body
#   ?measure  a recitals:CybersecurityRiskManagementMeasure
#             (the Art. 21 measures; risk:RiskManagement from
#             the DPV risk extension and dpv:RiskMitigationMeasure
#             are accepted too)
# Training uses DPV: ?x dpv:hasOrganisationalMeasure ?training
#################################################

ex:
    sh:declare [
        sh:prefix "dpv" ;
        sh:namespace "https://w3id.org/dpv#"^^xsd:anyURI ;
    ] , [
        sh:prefix "risk" ;
        sh:namespace "https://w3id.org/dpv/risk#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdfs" ;
        sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ;
    ] , [
        sh:prefix "recitals" ;
        sh:namespace "http://example.org/recitals/"^^xsd:anyURI ;
    ] .

#################################################
# Scope: there must be an entity to assess
#################################################

ex:NIS2Art20ScopeShape
    a sh:NodeShape ;
    sh:targetNode recitals:NIS2Article20Scope ;

    # NIS2 Art. 20 scope: fails when the data has nothing this article applies to
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "N20-0"^^xsd:string ;
        sh:message "No essential or important entity found; NIS2 Art. 20 cannot be assessed." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    ?e rdf:type ?t .
                    FILTER (?t IN (recitals:EssentialEntity, recitals:ImportantEntity))
                }
            }
        """ ;
    ] .

#################################################
# Essential / important entity
#################################################

ex:NIS2Art20EntityShape
    a sh:NodeShape ;
    sh:targetClass recitals:EssentialEntity , recitals:ImportantEntity ;

    # NIS2 Art. 20(1): entity does not identify its management body
    sh:property [
        sh:path recitals:hasManagementBody ;
        dct:identifier "N20-1-0"^^xsd:string ;
        sh:minCount 1 ;
        sh:class recitals:ManagementBody ;
        sh:message "Entity does not identify its management body (Art. 20(1))." ;
    ] ;

    # Art. 20(1): management body approves the Art. 21 measures
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "N20-1-1"^^xsd:string ;
        sh:message "No cybersecurity risk-management measure approved by the entity's management body (Art. 20(1))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this recitals:hasManagementBody ?body .
                    $this dpv:hasTechnicalMeasure|dpv:hasOrganisationalMeasure ?m .
                    ?m recitals:approvedBy ?body .
                    ?m rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (recitals:CybersecurityRiskManagementMeasure, risk:RiskManagement, dpv:RiskMitigationMeasure))
                }
            }
        """ ;
    ] ;

    # Art. 20(1): management body oversees implementation
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "N20-1-2"^^xsd:string ;
        sh:message "Approved cybersecurity risk-management measure whose implementation is not overseen by the management body (Art. 20(1))." ;
        sh:select """
            SELECT $this ?value WHERE {
                $this recitals:hasManagementBody ?body .
                $this dpv:hasTechnicalMeasure|dpv:hasOrganisationalMeasure ?value .
                ?value recitals:approvedBy ?body .
                FILTER NOT EXISTS {
                    ?value recitals:implementationOverseenBy ?body .
                }
            }
        """ ;
    ] .

# Same targets, warning level: staff training, which Art. 20(2) only asks entities to encourage
ex:NIS2Art20EntityWarningShape
    a sh:NodeShape ;
    sh:targetClass recitals:EssentialEntity , recitals:ImportantEntity ;
    # Severity applies to every constraint of a shape, so the
    # "as appropriate" checks live in their own shape.
    sh:severity sh:Warning ;

    # Art. 20(2): staff training is encouraged ("shall encourage")
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "N20-2-2"^^xsd:string ;
        sh:message "No regular cybersecurity training offered to employees (Art. 20(2))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dpv:hasOrganisationalMeasure ?t .
                    ?t rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:CybersecurityTraining, dpv:SecurityKnowledgeTraining, dpv:StaffTraining))
                }
            }
        """ ;
    ] .

#################################################
# Management body
#################################################

ex:NIS2Art20ManagementBodyShape
    a sh:NodeShape ;
    sh:targetClass recitals:ManagementBody ;

    # Art. 20(2): members of the management body are required to follow training
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        dct:identifier "N20-2-1"^^xsd:string ;
        sh:message "Management body does not follow cybersecurity training (Art. 20(2))." ;
        sh:select """
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this dpv:hasOrganisationalMeasure ?t .
                    ?t rdf:type?/rdfs:subClassOf* ?c .
                    FILTER (?c IN (dpv:CybersecurityTraining, dpv:SecurityKnowledgeTraining))
                }
            }
        """ ;
    ] .
