#################################################
# Controller ROPA Shape
#################################################

# ex:ControllerROPAShape
#     a sh:NodeShape ;
#     sh:targetClass dpv:ROPA ;

#     sh:property [
#         sh:path dpv:hasDataController ;
#         sh:minCount 1 ;
#         sh:class dpv:DataController ;
#         sh:message "ROPA must identify a Data Controller." ;
#     ] ;

# .

ex:ControllerROPAShape
    a sh:NodeShape ;
    sh:targetSubjectsOf dpv:hasDataController ;

    # GDPR Art. 30(1)(b): controller ROPA must reference at least one processing activity
    sh:property [
        sh:path dpv:hasProcess ;
        #dct:identifier "A30-1-22"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:Process ;
        sh:message "Controller ROPA must reference at least one processing activity." ;
    ] ;

    # GDPR Art. 30(1)(a): controller ROPA must include the Controller's Representative
    sh:property [
        sh:path dpv:hasRepresentative ;
        dct:identifier "A30-1-5"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:Representative ;
        sh:message "Controller ROPA must include the Controller's Representative." ;
    ] ;

    # GDPR Art. 30(1)(a): controller ROPA must include a Data Protection Officer where required
    sh:property [
        sh:path dpv:hasDataProtectionOfficer ;
        dct:identifier "A30-1-8"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:DataProtectionOfficer ;
        sh:message "Controller ROPA must include a Data Protection Officer where required." ;
    ] ;

.

#################################################
# Controller Shape
#################################################

ex:ControllerShape
    a sh:NodeShape ;
    sh:targetClass dpv:DataController ;

    # GDPR Art. 30(1): controller does not have a ROPA
    sh:property [
        sh:path dpv:hasRecordOfActivity ;
        dct:identifier "A30-1-1"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:ROPA ;
        sh:message "Controller does not have a ROPA." ] ; 

    # GDPR Art. 30(1)(a): ROPA does not contain name of controller
    sh:property [
        sh:path dpv:hasName ;
        dct:identifier "A30-1-3"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ROPA does not contain name of controller." ;
    ] ;

    # GDPR Art. 30(1)(a): ROPA does not contain contact details of controller
    sh:property [
        sh:path dpv:hasContact ;
        dct:identifier "A30-1-4"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ROPA does not contain contact details of controller." ;
    ] ;


.

#################################################
# Processor Shape
#################################################

ex:ProcessorShape
    a sh:NodeShape ;
    sh:targetClass dpv:DataProcessor ;

    # GDPR Art. 30(2): data processor does not have a ROPA
    sh:property [
        sh:path dpv:hasRecordOfActivity ;
        dct:identifier "A30-1-27"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:ROPA ;
        sh:message "Data Processor does not have a ROPA." ] ;
        
    # GDPR Art. 30(2)(a): ROPA does not contain name of processor
    sh:property [
        sh:path dpv:hasName ;
        dct:identifier "A30-1-29"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ROPA does not contain name of processor." 
    ] ;

    # GDPR Art. 30(2)(a): ROPA does not contain contact details of processor
    sh:property [
        sh:path dpv:hasContact ;
        dct:identifier "A30-1-30"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ROPA does not contain contact details of processor." 
    ] ;
.


#################################################
# Processor ROPA Shape
#################################################

# ex:ProcessorROPAShape
#     a sh:NodeShape ;
#     sh:targetClass dpv:DataProcessingRecord ;

#     sh:property [
#         sh:path dpv:hasDataProcessor ;
#         sh:minCount 1 ;
#         sh:class dpv:DataProcessor ;
#         sh:message "Processor ROPA must identify a Data Processor." ;
#     ] ;

ex:ProcessorROPAShape
    a sh:NodeShape ;
    sh:targetSubjectsOf dpv:hasDataProcessor ;

    # GDPR Art. 30(2)(b): processor ROPA must reference at least one processing activity
    sh:property [
        sh:path dpv:hasProcess ;
        sh:minCount 1 ;
        sh:class dpv:Process ;
        sh:message "Processor ROPA must reference at least one processing activity." ;
    ] ;

    # GDPR Art. 30(2)(a): processor ROPA must include its Representative
    sh:property [
        sh:path dpv:hasRepresentative ;
        dct:identifier "A30-1-31"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:Representative ;
        sh:message "Processor ROPA must include its Representative." ;
    ] ;

    # GDPR Art. 30(2)(a): processor ROPA must include a Data Protection Officer where required
    sh:property [
        sh:path dpv:hasDataProtectionOfficer ;
        dct:identifier "A30-1-34"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:DataProtectionOfficer ;
        sh:message "Processor ROPA must include a Data Protection Officer where required." ;
    ] ;

    # GDPR Art. 30(2)(d): processor ROPA must include technical security measures
    sh:property [
        sh:path dpv:hasTechnicalMeasure ;
        dct:identifier "A30-1-50"^^xsd:string;
        sh:minCount 1 ;
        sh:message "Processor ROPA must include technical security measures." ;
    ] ;

    # GDPR Art. 30(2)(d): processor ROPA must include organisational security measures
    sh:property [
        sh:path dpv:hasOrganisationalMeasure ;
        dct:identifier "A30-1-51"^^xsd:string;
        sh:minCount 1 ;
        sh:message "Processor ROPA must include organisational security measures." ;
    ] .

#################################################
# Representative Shape
#################################################

ex:RepresentativeShape
    a sh:NodeShape ;
    sh:targetClass dpv:Representative ;

    # GDPR Art. 30(1)(a): ROPA does not contain name of controller's representative
    sh:property [
        sh:path dpv:hasName ;
        dct:identifier "A30-1-6"^^xsd:string;
        dct:identifier "A30-1-32"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "ROPA does not contain name of controller's representative." ;
    ] ;

    # GDPR Art. 30(1)(a): ROPA does not contain contact details of controller's representative
    sh:property [
        sh:path dpv:hasContact ;
        dct:identifier "A30-1-7"^^xsd:string;
        dct:identifier "A30-1-33"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "ROPA does not contain contact details of controller's representative." ;
    ] .




#################################################
# DPO Shape
#################################################

ex:DPOShape
    a sh:NodeShape ;
    sh:targetClass dpv:DataProtectionOfficer ;

    # GDPR Art. 30(1)(a): ROPA does not contain name of data protection officer
    sh:property [
        sh:path dpv:hasName ;
        dct:identifier "A30-1-9"^^xsd:string;
        dct:identifier "A30-1-35"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "ROPA does not contain name of data protection officer." ;
    ] ;

    # GDPR Art. 30(1)(a): ROPA does not contain contact details of data protection officer
    sh:property [
        sh:path dpv:hasContact ;
        dct:identifier "A30-1-10"^^xsd:string;
        dct:identifier "A30-1-36"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:severity sh:Warning ;
        sh:message "ROPA does not contain contact details of data protection officer." ;
    ] .

#################################################
# Joint Controller Shape
#################################################

ex:JointControllerShape
    a sh:NodeShape ;
    sh:targetClass dpv:JointDataControllers , dpv:JointDataController ;

    # GDPR Art. 30(1)(a): ROPA does not contain name of joint controller
    sh:property [
        sh:path dpv:hasName ;
        dct:identifier "A30-1-12"^^xsd:string;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "ROPA does not contain name of joint controller." ;
    ] ;

    # GDPR Art. 30(1)(a): ROPA does not contain contact details of joint controller
    sh:property [
        sh:path dpv:hasContact ;
        dct:identifier "A30-1-13"^^xsd:string;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "ROPA does not contain contact details of joint controller." ;
    ] .

