@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .

#################################################
# GDPR Article 30 - Records of processing activities
#
# DPV terms follow DPV 2.3. For data written before that,
# these older names are still accepted:
#   dpv:hasJointDataController  (DPV 2.3: dpv:hasJointDataControllers)
#   dpv:JointDataController     (DPV 2.3: dpv:JointDataControllers)
# Not used by these shapes, so no alternative is needed:
#   dpv:hasTransfer   (link a dpv:Transfer with dpv:hasProcessing)
#   dpv:PersonalDataCategory (use dpv:PersonalData or a pd: category)
#################################################

#################################################
# Prefixes available to SPARQL-based constraints
#################################################

ex:
    sh:declare [
        sh:prefix "dpv" ;
        sh:namespace "https://w3id.org/dpv#"^^xsd:anyURI ;
    ] , [
        sh:prefix "rdf" ;
        sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ;
    ] .

#################################################
# BASE ROPA Shape
#################################################

ex:BaseROPAShape
    a sh:NodeShape ;
    sh:targetClass dpv:ROPA ;
    dct:identifier "G_Base-1"^^xsd:string;

    # GDPR Art. 30(1)/(2): ROPA must identify at least a Data Controller or a Data Processor
    sh:or (        
        [
            sh:property [
                sh:path dpv:hasDataController ;
                sh:minCount 1 ;
                sh:class dpv:DataController ;
            ]
        ]
        [
            sh:property [
                sh:path dpv:hasDataProcessor ;
                sh:minCount 1 ;
                sh:class dpv:DataProcessor ;
            ]
        ]
        [
            sh:property [
                sh:path dpv:hasDataProcessor ;
                sh:minCount 1 ;
                sh:class dpv:DataSubProcessor ;
            ]
        ]
    ) ;

    sh:message "ROPA must identify at least a Data Controller or a Data Processor." .


#################################################
# Processing Activity Shape
#################################################

ex:ProcessingShape
    a sh:NodeShape ;
    sh:targetClass dpv:Process ;

    sh:node [
        sh:and (
            ex:LegalBasisRequirement
            ex:PurposeRequirement
            ex:DataSubjectRequirement
            ex:PersonalDataRequirement
            ex:RecipientRequirement
            ex:StorageRequirement
            ex:TechnicalMeasureRequirement
            ex:OrganisationalMeasureRequirement
        ) ;
        sh:message "ROPA is incomplete. One or more mandatory GDPR Art.30 fields are missing." ;
    ] ;


    # Joint Controller
    sh:property [
        sh:path [ sh:alternativePath ( dpv:hasJointDataControllers dpv:hasJointDataController ) ] ;
        dct:identifier "A30-1-11"^^xsd:string;
        sh:minCount 1 ;
        sh:or ( [ sh:class dpv:JointDataControllers ] [ sh:class dpv:JointDataController ] ) ;
        sh:message "Another organisation not identified as joint controllers." ;
    ] ;

    # Purpose
    sh:property [
        sh:path dpv:hasPurpose ;
        dct:identifier "A30-1-14"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:Purpose ;
        sh:message "activity does not contain purpose of processing." ;
    ] ;

    # Data Subjects
    sh:property [
        sh:path dpv:hasDataSubject ;
        dct:identifier "A30-1-15"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:DataSubject ;
        sh:message "activity does not contain categories of data subjects." ;
    ] ;

    # Personal Data Categories
    sh:property [
        sh:path dpv:hasPersonalData ;
        dct:identifier "A30-1-16"^^xsd:string;
        sh:minCount 1 ;
        #sh:class dpv:PersonalData ;
        sh:message "activity does not contain categories of personal data." ;
    ] ;



    # Transfer validation
    sh:property [
        sh:path dpv:hasOrganisationalMeasure ;
        dct:identifier "A30-1-18"^^xsd:string;
        dct:identifier "A30-1-43"^^xsd:string;
        sh:minCount 0 ;
        sh:node dpv:OrganisationalMeasure ;
        sh:message "organisational measures not contained." ;
    ] ;

    # Storage
    sh:property [
        sh:path dpv:hasStorageCondition ;
        dct:identifier "A30-1-24"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:StorageDuration ;
        sh:message "duration of storage of personal data after which it will be erased if not further needed not contained." ;
    ] ;

    # Technical Measures
    sh:property [
        sh:path dpv:hasTechnicalMeasure ;
        dct:identifier "A30-1-25"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:TechnicalMeasure ;
        sh:message "technical measures not contained." ;
    ] ;

    # Organisational Measures
    sh:property [
        sh:path dpv:hasOrganisationalMeasure ;
        dct:identifier "A30-1-26"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:OrganisationalMeasure ;
        sh:message "organisational measures not contained." ;
    ] ;

    .

#################################################
# Transfer Shape
#################################################

ex:TransferShape
    a sh:NodeShape ;
    dct:identifier "A30-1-18"^^xsd:string;
    sh:targetClass dpv:Transfer ;

    # Recipients
    sh:property [
        sh:path dpv:hasDataImporter ;
        dct:identifier "A30-1-17"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:Recipient ;
        sh:message "Activity does not contain categories of recipients." ;
    ] ;

    # GDPR Art. 30(1)(e): a transfer must state its legal basis
    sh:property [
        sh:path dpv:hasLegalBasis ;
        sh:minCount 1 ;
        sh:message "Transfer must specify a legal basis." ;
    ] .

#################################################
# Recipient Shape
#################################################

ex:RecipientShape
    a sh:NodeShape ;
    sh:targetClass dpv:Recipient ;
    # All checks below are warnings. SHACL takes the severity of a
    # SPARQL constraint from its shape, so it is set here.
    sh:severity sh:Warning ;

    #############################################
    # 1. Missing Location
    #############################################
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        sh:message "Location of recipient not identified." ;
        dct:identifier "A30-1-19"^^xsd:string ;

        sh:select """
            SELECT DISTINCT $this WHERE {
                FILTER NOT EXISTS {
                    $this dpv:hasLocation ?loc .
                }
            }
        """ ;
    ] ;

    #############################################
    # 2. Third Country Warning
    #############################################
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        sh:message "Location of recipient is a third country." ;
        dct:identifier "A30-1-20"^^xsd:string ;

        sh:select """
            SELECT DISTINCT $this WHERE {

                # Case 1: explicit third country relation
                {
                    $this dpv:hasThirdCountry ?tc .
                }

                UNION

                # Case 2: location typed as ThirdCountry
                {
                    $this dpv:hasLocation ?loc .
                    ?loc rdf:type dpv:ThirdCountry .
                }
            } LIMIT 1
        """ ;
    ] ;

    #############################################
    # 3. International Organisation Warning
    #############################################
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:prefixes ex: ;
        sh:message "Recipient is an international organisation." ;
        dct:identifier "A30-1-22"^^xsd:string ;

        sh:select """
            SELECT DISTINCT $this WHERE {
                $this rdf:type dpv:InternationalOrganisation .
            } LIMIT 1
        """ ;
    ] .

