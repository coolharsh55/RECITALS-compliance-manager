@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <http://example.com/> .
@prefix dpv: <https://w3id.org/dpv#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> . 

ex:ControllerShape
    a sh:NodeShape ;
    sh:targetClass dpv:DataController ;

    sh:property [
        sh:path dpv:hasRecordOfActivity ;
        dct:identifier "A30-1-1"^^xsd:string;
        sh:minCount 1 ;
        sh:class dpv:ROPA ;
        sh:message "Controller does not have a ROPA." ] ; 

    sh:property [
        sh:path dpv:hasName ;
        dct:identifier "A30-1-3"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ROPA deos not contain name of controller." ;
    ] ;

    sh:property [
        sh:path dpv:hasContact ;
        dct:identifier "A30-1-4"^^xsd:string;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "ROPA does not contain contact details of controller." ;
    ] ;


     .